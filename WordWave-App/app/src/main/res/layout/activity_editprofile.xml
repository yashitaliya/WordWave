<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="25dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/back_arrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/back_arrow"
                android:padding="4dp"
                app:tint="#203470"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit Profile"
                android:textColor="#203470"
                android:textSize="30sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="32dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:background="@drawable/profile_img"
                android:backgroundTint="#203470"
                android:layout_gravity="center" />
        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Information"
                android:textColor="#203470"
                android:textSize="30sp"
                android:layout_marginTop="20dp"
                android:textStyle="bold"
                android:layout_marginLeft="17dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_marginRight="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-mail"
                        android:textColor="#203470"
                        android:layout_marginBottom="5dp"
                        android:layout_marginEnd="20dp"
                        android:textSize="21sp"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/emailTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#203470"
                        android:background="@drawable/text_border"
                        android:paddingLeft="10dp"
                        android:text="yug12@gmail.com"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_marginRight="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textColor="#203470"
                        android:layout_marginBottom="5dp"
                        android:layout_marginTop="20dp"
                        android:textSize="21sp"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/usernameTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#203470"
                        android:background="@drawable/text_border"
                        android:paddingLeft="10dp"
                        android:text="Username"
                        android:textSize="20sp"/>



                    <TextView
                        android:layout_marginRight="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="D.O.B"
                        android:textColor="#203470"
                        android:layout_marginBottom="5dp"
                        android:layout_marginTop="20dp"
                        android:textSize="21sp"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/dobTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"
                        android:textColor="#203470"
                        android:background="@drawable/text_border"
                        android:paddingLeft="10dp"
                        android:text="Date Of Birth"
                        android:textSize="20sp"/>



                    <TextView
                        android:layout_marginRight="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile no."
                        android:textColor="#203470"
                        android:layout_marginBottom="5dp"
                        android:layout_marginTop="20dp"
                        android:textSize="21sp"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/mobNoTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="#203470"
                        android:background="@drawable/text_border"
                        android:paddingLeft="10dp"
                        android:text="--------"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gender"
                        android:textColor="#203470"
                        android:layout_marginTop="20dp"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">


                        <RadioGroup
                            android:id="@+id/radioGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/male_rdo_btn"
                                android:layout_width="wrap_content"
                                android:paddingRight="10dp"
                                android:layout_height="wrap_content"
                                android:textColor="#203470"
                                android:text="Male" />

                            <RadioButton
                                android:id="@+id/female_rdo_btn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingRight="10dp"
                                android:textColor="#203470"
                                android:text="Female" />

                            <RadioButton
                                android:id="@+id/other_rdo_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Other"
                                android:textColor="#203470" />
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/save_btn"
            android:layout_width="100dp"
            android:layout_height="45dp"
            android:textColor="@color/white"
            android:background="@drawable/btn_bg"
            android:layout_marginBottom="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text=" Submit "
            android:textSize="20sp"/>
    </LinearLayout>
</ScrollView>